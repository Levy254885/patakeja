{
  "name": "patakeja",
  "version": "1.0.0",
  "private": true,
  "description": "PataKeja: a nationwide Kenyan property marketplace (Next.js, Firebase, Cloudinary).",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "functions:build": "npm --prefix functions run build",
    "functions:deploy": "firebase deploy --only functions",
    "rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "seed": "node scripts/seed.mjs",
    "admin:bootstrap": "node scripts/bootstrap-super-admin.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^10.12.2",
    "lucide-react": "^0.395.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "firebase-admin": "^12.2.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
